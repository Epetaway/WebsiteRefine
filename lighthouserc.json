{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "PORT=3002 npm start",
      "startServerReadyPattern": "serving on port",
      "url": [
        "http://127.0.0.1:3002/",
        "http://127.0.0.1:3002/work",
        "http://127.0.0.1:3002/work/withyou",
        "http://127.0.0.1:3002/research",
        "http://127.0.0.1:3002/graduate-review"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.8}],
        "categories:accessibility": ["error", {"minScore": 0.95}],
        "categories:best-practices": ["warn", {"minScore": 0.9}],
        "categories:seo": ["warn", {"minScore": 0.9}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "tmp/lighthouse"
    }
  }
}
