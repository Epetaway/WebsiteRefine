{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/GalleryCard/**",
              "components/ProfileCard/**",
              "components/Stepper/**",
              "design-canvas.jsx",
              "handoff/**",
              "preview/**",
              "ui_kits/brand/**",
              "ui_kits/marketing/**",
              "ui_kits/mobile/**",
              "uploads/WithYou- Wireframe/**",
              "uploads/WithYou- Wireframe/_bundle/**",
              "uploads/WithYou- Wireframe/_bundle/components/**",
              "uploads/WithYou- Wireframe/components/**",
              "uploads/WithYou- Wireframe/design_handoff_withyou/**",
              "uploads/WithYou- Wireframe/design_handoff_withyou/components/**",
              "uploads/WithYou- Wireframe/prototype/**",
              "wy-icons.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|JetBrains Mono|Caveat))/i]",
        "message": "Font not provided by the design system. Available: Inter, JetBrains Mono, Caveat."
      },
      {
        "selector": "JSXOpeningElement[name.name='GalleryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:layout|theme|key|ref|className|style|children)$/]",
        "message": "<GalleryCard> doesn't accept that prop. Declared props: layout, theme."
      },
      {
        "selector": "JSXOpeningElement[name.name='GalleryCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:featured|mosaic)$/]",
        "message": "<GalleryCard> layout must be one of 'featured' | 'mosaic'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GalleryCard'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<GalleryCard> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:view|theme|name|age|photo|key|ref|className|style|children)$/]",
        "message": "<ProfileCard> doesn't accept that prop. Declared props: view, theme, name, age, photo."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileCard'] > JSXAttribute[name.name='view'] > Literal[value!=/^(?:partner|own)$/]",
        "message": "<ProfileCard> view must be one of 'partner' | 'own'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileCard'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ProfileCard> theme must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:theme|initialStep|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: theme, initialStep."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Stepper> theme must be one of 'light' | 'dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
