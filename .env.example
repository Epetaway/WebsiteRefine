# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/portfolio

# Optional email service for the retained server endpoint; the public Contact
# page currently uses direct mailto links and does not submit a form.
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=e@ehicksonjr.com

# Social Media APIs
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_youtube_channel_id_here
THREADS_APP_ID=your_threads_app_id_here
THREADS_APP_SECRET=your_threads_app_secret_here

# Analytics (Optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Password gate for case study prototype links (server-side check, never
# shipped to the client). Leave unset to disable prototype access entirely.
PROTOTYPE_ACCESS_PASSWORD=
# Minutes an unlock stays valid before the password must be re-entered
PROTOTYPE_ACCESS_TTL_MINUTES=30

# Development Environment Variables (Automatically set by hosting platforms)
NODE_ENV=production
PORT=5000
